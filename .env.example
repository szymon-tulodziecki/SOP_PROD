# SOP - environment variables template
# Copy to .env for local development only. Never commit real secrets.

# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=

# SQLAlchemy connection string. Prefer Docker Secrets in production.
DATABASE_URL=

# Flask
FLASK_ENV=development
SECRET_KEY=

# Microsoft Entra ID
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# Celery + Redis
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
# REDIS_URL — nieużywana bezpośrednio; broker konfigurowany przez CELERY_BROKER_URL

# Internal services (Docker network — http is intentional, traffic never leaves bridge network)
TEX_SERVICE_URL=http://tex-service:5002
FILESERVER_URL=http://fileserver:5003

# Limit czasu kompilacji LaTeX w sekundach (domyślnie 60)
LATEX_TIMEOUT=60

# Dozwolona domena logowania Microsoft (np. ans-elblag.pl)
ALLOWED_EMAIL_DOMAIN=ans-elblag.pl

# Wysyłka e-maili przez Microsoft Graph (task Celery send_email).
# Wymaga uprawnienia aplikacyjnego Mail.Send + admin consent w Entra ID
# oraz skrzynki z licencją Exchange Online (README, sekcja 3.4).
# Pusty MAIL_SENDER = wysyłka wyłączona (pominięcia widoczne w logach workera).
MAIL_SENDER=
# Publiczny adres aplikacji studenckiej — baza linków w mailach
# (np. https://praktyki.ans-elblag.pl)
PUBLIC_BASE_URL=
