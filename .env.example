# ─── SOP — Zmienne środowiskowe ──────────────────────────────────────────────
# Skopiuj ten plik jako .env i uzupełnij wartości.
# NIE COMMITUJ pliku .env do repozytorium!

# ── Baza danych PostgreSQL ──
POSTGRES_USER=ans_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=ans_praktyki

# ── Połączenie aplikacji z bazą (psycopg2) ──
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# ── Flask ──
FLASK_ENV=production
SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY

# ── Celery + Redis ──
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── TeX Service ──
TEX_SERVICE_URL=http://tex-service:5002
